<!-- Younggyo Seo:
Changed group of some visual geoms to support ray-tracing that passes through robots
-->

<mujoco model="g1_tactile">
  <compiler angle="radian" meshdir="meshes" />
  <option timestep="0.0005" iterations="50" solver="Newton" integrator="Euler" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <!-- Free-camera start pose. azimuth 120 looked through the contact wall
         (normal along Y, so the wall spans X); -145 places the initial view on a
         three-quarter angle off the robot's front-left, keeping the wall face
         and the pressing hand in frame. Costs nothing to change — this only
         seeds the interactive/free camera, it is not a rendered camera. -->
    <global azimuth="-145" elevation="-15" />
  </visual>

  <statistic center="0 0 0.5" extent="2.0" />

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.01" type="plane" material="groundplane" group="2" friction="1.2 0.005 0.0001" />

    <!-- Viewing cameras.
         All use mode="trackcom": the position is a fixed offset from the robot's
         centre of mass (so the robot stays framed as it walks) while the viewing
         direction stays fixed in world.

         Angles are chosen against the contact wall that make_wall_mjcf.py bakes
         in: a 10 m x 1.6 m box whose normal is the Y axis by default, i.e. it
         spans X. Which side of the wall the robot presses from flips per clip
         (wall_dir = +/-1), so the Y-facing views can end up looking through it —
         the X-facing "profile" views run PARALLEL to the wall and are therefore
         never occluded. Prefer those when a clip has a wall.

         NOTE: mujoco_ros2_control publishes EVERY camera declared here as ROS
         image + depth topics at camera_publish_rate (60 Hz, set in
         urdf/g1/mujoco.xacro). Under Docker on macOS there is no GPU, so each
         one is rendered offscreen in software (mesa) and costs real time. Lower
         camera_publish_rate, or comment out cameras you are not using, if the
         sim runs slow. -->

    <!-- Profile views: look along -/+X, parallel to a Y-normal wall (never blocked). -->
    <camera name="profile_left" mode="trackcom" pos="4.0 0 0.9" xyaxes="0 1 0 0 0 1" fovy="50" resolution="640 480" />
    <camera name="profile_right" mode="trackcom" pos="-4.0 0 0.9" xyaxes="0 -1 0 0 0 1" fovy="50" resolution="640 480" />

    <!-- Three-quarter view: offset on both axes so the torso and the pressing
         hand are both visible without staring straight down the wall. -->
    <camera name="three_quarter" mode="trackcom" pos="2.8 -2.8 1.6" xyaxes="0.707 0.707 0 -0.409 0.409 0.816" fovy="55" resolution="640 480" />

    <!-- Top-down: always unobstructed (wall is only 1.6 m tall); good for
         checking foot placement and the robot's distance to the wall. -->
    <camera name="top_down" mode="trackcom" pos="0 0 4.5" xyaxes="1 0 0 0 1 0" fovy="60" resolution="640 480" />
  </worldbody>

